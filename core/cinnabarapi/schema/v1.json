{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bedrock-mc/cinnabar-api/main/schema/v1.json",
  "title": "Cinnabar API v1",
  "description": "HTTP bodies and WebSocket messages of the Cinnabar API. Receivers ignore unknown fields and, after authentication, unknown message types.",
  "x-protocol": 1,
  "x-close-codes": {
    "4429": "Stay away: reason retry_after=<seconds>; reconnect only after that delay plus jitter. HTTP 429 Retry-After has the same meaning on dial."
  },
  "anyOf": [
    { "$ref": "#/$defs/ClientMessage" },
    { "$ref": "#/$defs/ServerMessage" },
    { "$ref": "#/$defs/HealthResponse" },
    { "$ref": "#/$defs/ReleaseHookRequest" },
    { "$ref": "#/$defs/ReleaseRecord" }
  ],
  "$defs": {
    "Channel": { "enum": ["stable", "beta", "nightly"] },
    "Version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "Xuid": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "U32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "Build": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Timestamp": {
      "description": "RFC 3339 UTC timestamp with millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },

    "HealthResponse": {
      "description": "GET /v1/health response.",
      "type": "object",
      "required": ["ok", "api"],
      "properties": { "ok": { "const": true }, "api": { "const": "v1" } }
    },
    "ReleaseHookRequest": {
      "description": "POST /v1/releases body.",
      "type": "object",
      "required": ["channel", "version"],
      "properties": {
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" },
        "build": { "$ref": "#/$defs/Build" }
      }
    },
    "ReleaseRecord": {
      "description": "Latest accepted release identity for a channel.",
      "type": "object",
      "required": ["channel", "version", "published_at"],
      "properties": {
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" },
        "build": { "$ref": "#/$defs/Build" },
        "published_at": { "$ref": "#/$defs/Timestamp" }
      }
    },

    "ClientMessage": {
      "anyOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/Proof" },
        { "$ref": "#/$defs/Visibility" },
        { "$ref": "#/$defs/Lookup" },
        { "$ref": "#/$defs/EmoteState" }
      ]
    },
    "Hello": {
      "type": "object",
      "required": ["type", "protocol", "client_version", "channel", "visible", "token"],
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "const": 1 },
        "client_version": { "$ref": "#/$defs/Version" },
        "client_build": { "$ref": "#/$defs/Build" },
        "channel": { "$ref": "#/$defs/Channel" },
        "visible": { "type": "boolean" },
        "token": {
          "description": "Minecraft multiplayer token (compact JWS).",
          "type": "string",
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        }
      }
    },
    "Proof": {
      "type": "object",
      "required": ["type", "signature"],
      "properties": {
        "type": { "const": "proof" },
        "signature": {
          "description": "Unpadded base64url of the 96-byte raw r||s ES384 signature over \"cinnabar-api/v1/auth:\" + nonce.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      }
    },
    "Visibility": {
      "type": "object",
      "required": ["type", "visible"],
      "properties": {
        "type": { "const": "visibility" },
        "visible": { "type": "boolean" }
      }
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Lookup": {
      "description": "Both identifier arrays are optional and may be empty. Their combined length must not exceed lookup_batch_max (128); the server enforces the combined limit.",
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "lookup" },
        "id": { "$ref": "#/$defs/U32" },
        "xuids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Xuid" } },
        "uuids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },

    "ServerMessage": {
      "anyOf": [
        { "$ref": "#/$defs/Challenge" },
        { "$ref": "#/$defs/Welcome" },
        { "$ref": "#/$defs/Error" },
        { "$ref": "#/$defs/LookupResult" },
        { "$ref": "#/$defs/Release" },
        { "$ref": "#/$defs/Emote" },
        { "$ref": "#/$defs/Cosmetic" }
      ]
    },
    "Challenge": {
      "type": "object",
      "required": ["type", "nonce"],
      "properties": {
        "type": { "const": "challenge" },
        "nonce": {
          "description": "Unpadded base64url of 32 random bytes.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "Welcome": {
      "type": "object",
      "required": ["type", "xuid"],
      "properties": {
        "type": { "const": "welcome" },
        "xuid": { "$ref": "#/$defs/Xuid" },
        "lookup_batch_max": { "type": "integer", "minimum": 1, "default": 128 },
        "lookup_bucket_capacity": { "type": "integer", "minimum": 1, "default": 1024 },
        "lookup_refill_per_min": { "type": "integer", "minimum": 1, "default": 512 },
        "cache_ttl_ms": { "type": "integer", "minimum": 1, "default": 120000 },
        "ping_interval_ms": { "type": "integer", "minimum": 1, "default": 30000 },
        "reconnect_max_ms": { "type": "integer", "minimum": 1, "default": 300000 }
      }
    },
    "Error": {
      "description": "rate_limited carries the id of the refused lookup; unauthorized is followed by close code 4401.",
      "type": "object",
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["unauthorized", "rate_limited"] },
        "id": { "$ref": "#/$defs/U32" }
      }
    },
    "LookupResult": {
      "description": "Each array contains only matches from the corresponding request array. cinnabar_uuids may be omitted when no UUID array was requested.",
      "type": "object",
      "required": ["type", "id", "cinnabar"],
      "properties": {
        "type": { "const": "lookup_result" },
        "id": { "$ref": "#/$defs/U32" },
        "cinnabar": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Xuid" } },
        "cinnabar_uuids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },
    "Release": {
      "type": "object",
      "required": ["type", "channel", "version", "published_at"],
      "properties": {
        "type": { "const": "release" },
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" },
        "build": { "$ref": "#/$defs/Build" },
        "published_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "EmoteId": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^[a-z0-9_.:-]+$"
    },
    "EmoteState": {
      "description": "Replaces the nearby-player watch list and local emote. The combined identifier limit is 128. Null stops playback; elapsed_ms is the current playback phase. Omitting both identifier arrays retains subscriptions; an empty array clears them. Receivers ignore unknown clips. Optional hat_id updates the equipped hat on the same nearby subscription; null unequips it, omission retains the previous hat.",
      "type": "object",
      "required": [
        "type",
        "emote_id",
        "elapsed_ms"
      ],
      "properties": {
        "type": {
          "const": "emote_state"
        },
        "emote_id": {
          "$ref": "#/$defs/EmoteId"
        },
        "elapsed_ms": {
          "$ref": "#/$defs/U32"
        },
        "xuids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/Xuid"
          }
        },
        "uuids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/Uuid"
          }
        },
        "hat_id": {
          "$ref": "#/$defs/CosmeticId"
        }
      }
    },
    "Emote": {
      "description": "Authenticated sender identity with a bounded playback lease. Null stops playback. No server-provided actor identity is trusted.",
      "type": "object",
      "required": [
        "type",
        "xuid",
        "uuid",
        "emote_id",
        "elapsed_ms",
        "valid_for_ms"
      ],
      "properties": {
        "type": {
          "const": "emote"
        },
        "xuid": {
          "$ref": "#/$defs/Xuid"
        },
        "uuid": {
          "$ref": "#/$defs/Uuid"
        },
        "emote_id": {
          "$ref": "#/$defs/EmoteId"
        },
        "elapsed_ms": {
          "$ref": "#/$defs/U32"
        },
        "valid_for_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000
        }
      }
    },
    "CosmeticId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "Cosmetic": {
      "description": "Authenticated nearby cosmetic selection with a bounded lease. Null unequips; unknown identifiers are ignored by receivers.",
      "type": "object",
      "required": [
        "type",
        "xuid",
        "uuid",
        "hat_id",
        "valid_for_ms"
      ],
      "properties": {
        "type": {
          "const": "cosmetic"
        },
        "xuid": {
          "$ref": "#/$defs/Xuid"
        },
        "uuid": {
          "$ref": "#/$defs/Uuid"
        },
        "hat_id": {
          "$ref": "#/$defs/CosmeticId"
        },
        "valid_for_ms": {
          "$ref": "#/$defs/Emote/properties/valid_for_ms"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bedrock-mc/cinnabar-api/main/schema/v1.json",
  "title": "Cinnabar API v1",
  "description": "HTTP bodies and WebSocket messages of the Cinnabar API. Receivers ignore unknown message types and unknown fields.",
  "x-protocol": 1,
  "anyOf": [
    { "$ref": "#/$defs/ClientMessage" },
    { "$ref": "#/$defs/ServerMessage" },
    { "$ref": "#/$defs/HealthResponse" },
    { "$ref": "#/$defs/ReleaseHookRequest" },
    { "$ref": "#/$defs/ReleaseRecord" }
  ],
  "$defs": {
    "Channel": { "enum": ["stable", "beta", "nightly"] },
    "Version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "Xuid": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "U32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "Timestamp": {
      "description": "RFC 3339 UTC timestamp with millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },

    "HealthResponse": {
      "description": "GET /v1/health response.",
      "type": "object",
      "required": ["ok", "api"],
      "properties": { "ok": { "const": true }, "api": { "const": "v1" } }
    },
    "ReleaseHookRequest": {
      "description": "POST /v1/releases body.",
      "type": "object",
      "required": ["channel", "version"],
      "properties": {
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "ReleaseRecord": {
      "description": "GET /v1/releases/latest response.",
      "type": "object",
      "required": ["channel", "version", "published_at"],
      "properties": {
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" },
        "published_at": { "$ref": "#/$defs/Timestamp" }
      }
    },

    "ClientMessage": {
      "anyOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/Proof" },
        { "$ref": "#/$defs/Visibility" },
        { "$ref": "#/$defs/Lookup" }
      ]
    },
    "Hello": {
      "type": "object",
      "required": ["type", "protocol", "client_version", "channel", "visible", "token"],
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "const": 1 },
        "client_version": { "$ref": "#/$defs/Version" },
        "channel": { "$ref": "#/$defs/Channel" },
        "visible": { "type": "boolean" },
        "token": {
          "description": "Minecraft multiplayer token (compact JWS).",
          "type": "string",
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        }
      }
    },
    "Proof": {
      "type": "object",
      "required": ["type", "signature"],
      "properties": {
        "type": { "const": "proof" },
        "signature": {
          "description": "Unpadded base64url of the 96-byte raw r||s ES384 signature over \"cinnabar-api/v1/auth:\" + nonce.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      }
    },
    "Visibility": {
      "type": "object",
      "required": ["type", "visible"],
      "properties": {
        "type": { "const": "visibility" },
        "visible": { "type": "boolean" }
      }
    },
    "Lookup": {
      "type": "object",
      "required": ["type", "id", "xuids"],
      "properties": {
        "type": { "const": "lookup" },
        "id": { "$ref": "#/$defs/U32" },
        "xuids": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Xuid" } }
      }
    },

    "ServerMessage": {
      "anyOf": [
        { "$ref": "#/$defs/Challenge" },
        { "$ref": "#/$defs/Welcome" },
        { "$ref": "#/$defs/Error" },
        { "$ref": "#/$defs/LookupResult" },
        { "$ref": "#/$defs/Release" }
      ]
    },
    "Challenge": {
      "type": "object",
      "required": ["type", "nonce"],
      "properties": {
        "type": { "const": "challenge" },
        "nonce": {
          "description": "Unpadded base64url of 32 random bytes.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "Welcome": {
      "type": "object",
      "required": ["type", "xuid", "display_name"],
      "properties": {
        "type": { "const": "welcome" },
        "xuid": { "$ref": "#/$defs/Xuid" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "Error": {
      "description": "rate_limited carries the id of the refused lookup; unauthorized is followed by close code 4401.",
      "type": "object",
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["unauthorized", "rate_limited"] },
        "id": { "$ref": "#/$defs/U32" }
      }
    },
    "LookupResult": {
      "type": "object",
      "required": ["type", "id", "cinnabar"],
      "properties": {
        "type": { "const": "lookup_result" },
        "id": { "$ref": "#/$defs/U32" },
        "cinnabar": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Xuid" } }
      }
    },
    "Release": {
      "type": "object",
      "required": ["type", "channel", "version", "published_at"],
      "properties": {
        "type": { "const": "release" },
        "channel": { "$ref": "#/$defs/Channel" },
        "version": { "$ref": "#/$defs/Version" },
        "published_at": { "$ref": "#/$defs/Timestamp" }
      }
    }
  }
}

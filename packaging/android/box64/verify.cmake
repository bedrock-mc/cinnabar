# Reject a native runtime whose dynamic dependencies are absent from the APK.
cmake_minimum_required(VERSION 3.24)
file(READ "${MANIFEST}" runtime)
string(JSON helper GET "${runtime}" bds_translation helper_library)
set(files "${helper}")
string(JSON count LENGTH "${runtime}" bds_translation native_runtime libraries)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${runtime}" bds_translation native_runtime libraries ${index} packaged)
    list(APPEND files "${name}")
endforeach()

set(provided)
set(required)
foreach(name IN LISTS files)
    execute_process(COMMAND "${READELF}" -h -d "${DIRECTORY}/${name}"
        RESULT_VARIABLE status OUTPUT_VARIABLE elf ERROR_VARIABLE detail)
    if(NOT status EQUAL 0 OR NOT elf MATCHES "Machine:[ \t]+AArch64" OR NOT elf MATCHES "Type:[ \t]+DYN")
        message(FATAL_ERROR "Invalid ARM64 native runtime file ${name}: ${detail}")
    endif()
    if(elf MATCHES "Library soname: \\[([^]]+)\\]")
        list(APPEND provided "${CMAKE_MATCH_1}")
    endif()
    string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" dependencies "${elf}")
    foreach(dependency IN LISTS dependencies)
        string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" dependency "${dependency}")
        list(APPEND required "${dependency}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES required)
foreach(dependency IN LISTS required)
    if(NOT dependency IN_LIST provided)
        message(FATAL_ERROR "Native BDS runtime dependency is not packaged: ${dependency}")
    endif()
endforeach()

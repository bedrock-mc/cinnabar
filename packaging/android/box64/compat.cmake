# Add Android's application-safe interface enumeration and name resolution, and the code cache's
# write budget, to the Linux translator.
enable_language(CXX)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../runtime.json")
function(cinnabar_android_network)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime.json" runtime)
    string(JSON count LENGTH "${runtime}" bds_translation network_adapter files)
    math(EXPR last "${count} - 1")
    set(directory "${CMAKE_BINARY_DIR}/android-network")
    set(upstream "${directory}/upstream")
    file(MAKE_DIRECTORY "${upstream}")
    foreach(index RANGE ${last})
        foreach(field name url sha256)
            string(JSON ${field} GET "${runtime}" bds_translation network_adapter files ${index} ${field})
        endforeach()
        file(DOWNLOAD "${url}" "${upstream}/${name}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON)
    endforeach()
    file(READ "${upstream}/ifaddrs.cpp" source)
    # This executable always runs as an application, including in developer tests.
    string(REPLACE "#include <cutils/misc.h>           // FIRST_APPLICATION_UID" "" source "${source}")
    string(REPLACE "if (getuid() < FIRST_APPLICATION_UID)" "if (false)" source "${source}")
    string(REPLACE "#include <async_safe/log.h>" "" source "${source}")
    string(REPLACE "#include \"private/ErrnoRestorer.h\"" "" source "${source}")
    file(WRITE "${directory}/ifaddrs.cpp" "${source}")
    foreach(name bionic_netlink.cpp bionic_netlink.h)
        file(READ "${upstream}/${name}" source)
        string(REPLACE "#include \"private/ErrnoRestorer.h\"" "" source "${source}")
        string(REPLACE "#include \"private/ScopedFd.h\"" "" source "${source}")
        file(WRITE "${directory}/${name}" "${source}")
    endforeach()
    add_library(android_network OBJECT "${directory}/ifaddrs.cpp" "${directory}/bionic_netlink.cpp"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/network.cpp")
    target_compile_features(android_network PRIVATE cxx_std_17)
    target_compile_options(android_network PRIVATE -fno-exceptions -fno-rtti -nostdinc++
        -include "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/network.h")
    target_compile_definitions(android_network PRIVATE getifaddrs=cinnabar_getifaddrs freeifaddrs=cinnabar_freeifaddrs)
    add_library(android_dns OBJECT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dns.cpp")
    target_compile_features(android_dns PRIVATE cxx_std_17)
    target_compile_options(android_dns PRIVATE -fno-exceptions -fno-rtti -nostdinc++)
    # No C++ runtime is needed: allocation, logging and fd ownership use libc.
    target_sources(box64 PRIVATE $<TARGET_OBJECTS:android_network> $<TARGET_OBJECTS:android_dns>)
    set_target_properties(box64 PROPERTIES LINKER_LANGUAGE C)
endfunction()
cmake_language(DEFER CALL cinnabar_android_network)
function(cinnabar_cache_budget)
    # Plain C for the patched cache writer; it needs no C++ runtime.
    target_sources(mainobj PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/cache_budget.c")
    target_include_directories(mainobj PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
endfunction()
cmake_language(DEFER CALL cinnabar_cache_budget)

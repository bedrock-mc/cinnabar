/* Rust bindings are generated from this table; C verifies each value against VitaSDK. */
CBN_BUTTON(SELECT, SCE_CTRL_SELECT, 0x0001)
CBN_BUTTON(START, SCE_CTRL_START, 0x0008)
CBN_BUTTON(UP, SCE_CTRL_UP, 0x0010)
CBN_BUTTON(RIGHT, SCE_CTRL_RIGHT, 0x0020)
CBN_BUTTON(DOWN, SCE_CTRL_DOWN, 0x0040)
CBN_BUTTON(LEFT, SCE_CTRL_LEFT, 0x0080)
CBN_BUTTON(L, SCE_CTRL_LTRIGGER, 0x0100)
CBN_BUTTON(R, SCE_CTRL_RTRIGGER, 0x0200)
CBN_BUTTON(TRIANGLE, SCE_CTRL_TRIANGLE, 0x1000)
CBN_BUTTON(CIRCLE, SCE_CTRL_CIRCLE, 0x2000)
CBN_BUTTON(CROSS, SCE_CTRL_CROSS, 0x4000)
CBN_BUTTON(SQUARE, SCE_CTRL_SQUARE, 0x8000)

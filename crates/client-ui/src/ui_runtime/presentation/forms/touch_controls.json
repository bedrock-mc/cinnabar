{
  "namespace": "cinnabar_touch",
  "button": {
    "type": "button",
    "layer": 10,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$control",
        "mapping_type": "pressed",
        "scope": "view"
      }
    ],
    "controls": [
      {
        "normal": {
          "type": "image",
          "texture": "$texture",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "held": {
          "type": "image",
          "texture": "$held_texture",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "$held_binding",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "screen": {
    "type": "screen",
    "render_only_when_topmost": false,
    "controls": [
      {
        "look": {
          "type": "input_panel",
          "size": [
            "100%",
            "100%"
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "cinnabar.touch.look",
              "mapping_type": "pressed",
              "scope": "view"
            }
          ]
        }
      },
      {
        "joystick": {
          "type": "button",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [
            24,
            -46
          ],
          "size": [
            64,
            64
          ],
          "layer": 10,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "cinnabar.touch.joystick",
              "mapping_type": "pressed",
              "scope": "view"
            }
          ],
          "controls": [
            {
              "frame": {
                "type": "image",
                "texture": "textures/ui/joystick_frame",
                "size": [
                  "100%",
                  "100%"
                ]
              }
            },
            {
              "knob": {
                "type": "draggable",
                "draggable": "both",
                "size": [
                  32,
                  32
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 1,
                "controls": [
                  {
                    "art": {
                      "type": "image",
                      "texture": "textures/ui/joystick_knob",
                      "size": [
                        "100%",
                        "100%"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "sprint@cinnabar_touch.button": {
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [
            92,
            -46
          ],
          "size": [
            28,
            28
          ],
          "$control": "cinnabar.touch.sprint",
          "$texture": "textures/ui/sprint",
          "$held_texture": "textures/ui/sprint_pressed",
          "$held_binding": "#touch_sprint_pressed"
        }
      },
      {
        "jump@cinnabar_touch.button": {
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -20,
            -44
          ],
          "size": [
            32,
            32
          ],
          "$control": "cinnabar.touch.jump",
          "$texture": "textures/ui/jump",
          "$held_texture": "textures/ui/jump_pressed",
          "$held_binding": "#touch_jump_pressed"
        }
      },
      {
        "sneak@cinnabar_touch.button": {
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -58,
            -44
          ],
          "size": [
            32,
            32
          ],
          "$control": "cinnabar.touch.sneak",
          "$texture": "textures/ui/sneak",
          "$held_texture": "textures/ui/sneak_pressed",
          "$held_binding": "#touch_sneak_pressed"
        }
      },
      {
        "attack@cinnabar_touch.button": {
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -20,
            -82
          ],
          "size": [
            32,
            32
          ],
          "$control": "cinnabar.touch.attack",
          "$texture": "textures/ui/attack",
          "$held_texture": "textures/ui/attack_pressed",
          "$held_binding": "#touch_attack_pressed"
        }
      },
      {
        "use@cinnabar_touch.button": {
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -58,
            -82
          ],
          "size": [
            32,
            32
          ],
          "$control": "cinnabar.touch.use",
          "$texture": "textures/ui/interact",
          "$held_texture": "textures/ui/interact_pressed",
          "$held_binding": "#touch_use_pressed"
        }
      },
      {
        "menu@cinnabar_touch.button": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -8,
            8
          ],
          "size": [
            24,
            24
          ],
          "$control": "cinnabar.touch.menu",
          "$texture": "textures/ui/pause_icon",
          "$held_texture": "textures/ui/pause_icon",
          "$held_binding": "#touch_menu_pressed"
        }
      },
      {
        "inventory@cinnabar_touch.button": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -36,
            8
          ],
          "size": [
            24,
            24
          ],
          "$control": "cinnabar.touch.inventory",
          "$texture": "textures/ui/inventory_mobile",
          "$held_texture": "textures/ui/inventory_mobile",
          "$held_binding": "#touch_inventory_pressed"
        }
      }
    ]
  }
}

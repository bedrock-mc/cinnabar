  "relay": {
    "framing": "Every Hello and control message is nonzero u32 big-endian JSON length followed by that many UTF-8 bytes. Stream/message chunks are arbitrary. Play bytes after Hello use the existing bridge framing unchanged.",
    "control_hello": {"version": 2, "channel": "control", "channels": ["control", "play"], "resume": "optional bearer"},
    "play_hello": {"version": 2, "channel": "play", "generation": 1, "join": "fresh nonzero identity for pack-stream delivery; omitted by legacy peers", "resume": "required for WebSocket; omitted for authenticated WebTransport"},
    "welcome": {"type": "welcome", "version": 2, "resume": "rotated bearer", "generation": 1, "expires_seconds": 120},
    "request": {"op": "sign_in, sign_out or pong", "resume": "pong echoes the bearer from the received ping"},
    "event": "account carries auth.v1 under account; connect carries ConnectProgress under connect; error carries a public code under error. ping carries the same capability fields as welcome and requires pong with that resume bearer. Unanswered pings repeat the pending bearer and report its remaining expiry. Unknown fields are optional extensions; unknown operations receive error. Malformed framing ends the transport.",
    "lifecycle": "A successful control Hello rotates the bearer and increments generation. Only one controller and one play stream may be active. Closing control cancels play. Resume retains account state, never gameplay. A ping refreshes an acknowledged bearer; pending replacements retain the prior bearer at its original expiry until acknowledged. Only pong for the current bearer extends the control read deadline. Rejected resume never creates a replacement account.",
    "fixtures": [
      {"version": 2, "channel": "control", "channels": ["control", "play"]},
      {"version": 2, "channel": "play", "generation": 1},
      {"version": 2, "channel": "play", "generation": 1, "join": 2},
      {"type": "welcome", "version": 2, "resume": "test-token", "generation": 1, "expires_seconds": 120},
      {"op": "sign_in"},
      {"op": "pong", "resume": "test-token"},
      {"op": "sign_out"},
      {"type": "account", "account": {"state": "awaiting_code", "verification_uri": "https://example.test/verify", "user_code": "TEST-CODE"}},
      {"type": "connect", "connect": {"stage": "packs", "packs_done": 1, "packs_total": 2, "received_bytes": 3, "total_bytes": 4}},
      {"type": "connect", "connect": {"stage": ""}},
      {"type": "error", "error": "resume_refused"},
      {"type": "error", "error": "admission_refused"},
      {"type": "error", "error": "session_busy"},
      {"type": "error", "error": "refused"},
      {"type": "ping", "version": 2, "resume": "test-token", "generation": 1, "expires_seconds": 120},
      {"type": "account", "account": {"state": "signed_out"}},
      {"type": "connect", "connect": {"stage": "packs", "packs_done": 1, "packs_total": 2, "received_bytes": 512, "total_bytes": 1024}}
    ]
  }

{
  "version": 1,
  "constants": {
    "MAX_PLAYERS": 4,
    "MAX_PACKET_BYTES": 16777216,
    "MAX_PACKET_COUNT": 1600,
    "MAX_PACK_READ_BYTES": 102400,
    "CAPABILITY_BYTES": 32,
    "OPENING_BYTES": 16,
    "FLUSH_MILLIS": 50,
    "CLOSE_MILLIS": 5000,
    "MAX_OPEN_MILLIS": 60000
  },
  "shared_constants": {"QUEUED_BYTES": "RELAY_QUEUED_FRAME_BYTES"},
  "command": "native-world-bridge ",
  "flow": "One Packet followed by Flush is outstanding per direction until Flushed; controls remain readable while its single payload is pending.",
  "kinds": [
    ["Hello", 1, "control"], ["Snapshot", 2, "control"],
    ["Open", 3, "packet"], ["Opened", 4, "control"],
    ["Rejected", 5, "control"], ["ReadPack", 6, "control"],
    ["PackBytes", 7, "pack"], ["Attach", 8, "control"],
    ["World", 9, "packet"], ["Initialized", 10, "control"],
    ["Packet", 11, "packet"], ["Flush", 12, "control"],
    ["Flushed", 13, "control"], ["Close", 14, "control"],
    ["Closed", 15, "control"]
  ],
  "records": {
    "Bootstrap": [["address", "string"], ["opening", "string"], ["capability", "string"]],
    "Hello": [["version", "u32"], ["opening", "string"], ["capability", "string"], ["peer", "u64"]],
    "Pack": [["id", "string"], ["version", "string"], ["size", "u64"], ["sha256", "string"], ["content_key", "string"], ["content_identity", "string"], ["download_url", "string"], ["pack_type", "u32"], ["premium", "bool"]],
    "Snapshot": [["protocol_version", "u32"], ["max_players", "u32"], ["max_chunk_radius", "u32"], ["required", "bool"], ["packs", "list:Pack"]],
    "Identity": [["xuid", "string"], ["uuid", "string"], ["display_name", "string"], ["playfab_id", "string"], ["playfab_title_id", "string"]],
    "Open": [["peer", "u64"], ["remaining_millis", "u64"], ["identity", "Identity"], ["client_data", "raw"]],
    "PeerResult": [["peer", "u64"], ["code", "u32"]],
    "Range": [["archive", "u32"], ["offset", "u64"], ["length", "u32"]],
    "Initialized": [["cache_enabled", "bool"], ["radius", "u32"]],
    "WorldPolicy": [["max_radius", "u32"], ["initial_radius", "u32"], ["packet_count", "u32"]]
  }
}

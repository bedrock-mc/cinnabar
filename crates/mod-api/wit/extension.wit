package cinnabar:extension@0.1.0;

/// A retained, plain-text label drawn by the host's JSON-UI engine.
interface hud {
    /// Replaces this mod's label. Empty text removes it; invalid text is rejected.
    set-label: func(text: string) -> result<_, string>;
    /// Bounded host-rendered HUD cards; requires hud authority. Empty clears them.
    set-content: func(json: string) -> result<_, string>;
    /// Atomically replaces named HUD cards, removes named cards, and optionally replaces
    /// presentation metadata while retaining other cards. Uses the bounded HudUpdate schema.
    update-content: func(json: string) -> result<_, string>;
    /// Replaces only a normally visible crosshair; requires hud authority. Empty restores it.
    set-crosshair: func(json: string) -> result<_, string>;
    /// Adds one bounded local-only system chat line after a successful callback; requires hud.
    local-message: func(text: string) -> result<_, string>;
    record point { x: f32, y: f32 }
    record placement { id: string, position: option<point> }
    record editor-result { saved: bool, reset: bool, placements: list<placement> }
    record layout-placement { id: string, position: option<point>, scale: f32 }
    record layout-result { saved: bool, reset: bool, placements: list<layout-placement> }
    enum anchor { top-left, top-center, top-right, left, center, right, bottom-left, bottom-center, bottom-right }
    record anchored-placement { id: string, anchor: anchor, offset: point, scale: f32 }
    record anchored-layout-result { saved: bool, reset: bool, placements: list<anchored-placement> }
    /// Opens a host-owned layout editor from an input-owning panel. Requires hud and controls.
    /// JSON is bounded HUD preview data, including cards disabled during normal gameplay.
    open-editor: func(json: string) -> result<_, string>;
    /// Stable for this callback; consumed after a successful callback that reads it.
    /// Save carries normalized placements; cancel carries no placements.
    read-editor-result: func() -> result<option<editor-result>, string>;
    /// Reads positions and uniform scales; shares consumption with the legacy result.
    read-editor-layout: func() -> result<option<layout-result>, string>;
    /// Reads GUI-pixel offsets inward from edges, or right/down from centered axes.
    /// Shares stable callback lifetime and consumption with both normalized reads.
    read-editor-anchored-layout: func() -> result<option<anchored-layout-result>, string>;
}

/// Read-only, session-bound facts about the local player's presented inventory and effects.
interface player-state {
    record item {
        /// None when the negotiated registry cannot resolve the item.
        identifier: option<string>,
        network-id: s32,
        metadata: u32,
        count: u16,
        /// Canonical block-item route or a retained wire block identity.
        block: bool,
        /// Accepted response corrections take precedence over the stack's Damage tag.
        damage: option<u32>,
        /// None for items without a known durability maximum, including custom components.
        max-durability: option<u32>,
    }
    record slot {
        /// False until this inventory cell has authoritative or selected-equipment evidence.
        known: bool,
        item: option<item>,
    }
    record effect {
        effect-id: s32,
        /// The wire amplifier is zero-based and is not a display level.
        amplifier: s32,
        /// Remaining 20 Hz server ticks; none is an infinite effect.
        remaining-ticks: option<u64>,
        ambient: bool,
        particles: bool,
    }
    record snapshot {
        session: u64,
        dimension: s32,
        selected-slot: option<u8>,
        /// Exactly 36 cells, with hotbar cells first, in the host's presented inventory order.
        inventory: list<slot>,
        /// Helmet, chestplate, leggings, boots, with unknown cells preserved.
        armor: list<slot>,
        offhand: slot,
        /// Currently visible status effects, sorted by effect id, without expired entries.
        effects: list<effect>,
    }
    record world-observation {
        session: u64,
        /// Stable, host-selected destination identity; never a session generation.
        %world: string,
        dimension: s32,
        position: tuple<f32, f32, f32>,
        alive: bool,
    }
    record motion {
        session: u64, dimension: s32,
        /// Actor YXZ degrees: yaw left and pitch up. Velocity is blocks per simulation tick.
        yaw: f32, pitch: f32, velocity: tuple<f32, f32, f32>, on-ground: bool,
    }
    record food {nutrition: u32, saturation-modifier: f32}
    record vitals {
        session: u64, dimension: s32,
        hunger: option<f32>, max-hunger: option<f32>, saturation: option<f32>, held-food: option<food>,
    }
    record bounds { min: tuple<f32, f32, f32>, max: tuple<f32, f32, f32> }
    record actor {
        session: u64, dimension: s32, runtime-id: u64, player: bool,
        position: tuple<f32, f32, f32>, boxes: list<bounds>, name: string,
        identifier: string, yaw: f32, pitch: f32, pickable: bool,
        /// Native attack ray eligibility with current world obstruction/reach; absent when no valid ray exists.
        hittable: option<bool>,
        /// Retained native look origin and direction, not a guessed bounding-box eye height.
        look-origin: option<tuple<f32,f32,f32>>, look-direction: option<tuple<f32,f32,f32>>,
        invisible: bool, sneaking: bool, hurt: bool, health: option<f32>,
    }
    record observed-actor {
        actor: actor,
        /// Replicated health attribute maximum; absent when the server has supplied none.
        max-health: option<f32>,
    }
    enum combat-kind { attack-admitted, hurt, death }
    record combat-event {
        sequence: u64, session: u64, dimension: s32, kind: combat-kind,
        local: bool, player: bool,
        runtime-id: u64, distance: option<f32>, position: tuple<f32, f32, f32>,
    }
    /// Read-only presented motion; requires player-state authority, including while menus own input.
    read-motion: func() -> result<option<motion>, string>;
    /// Authoritative current food attributes; unknown fields remain absent, never estimated.
    read-vitals: func() -> result<option<vitals>, string>;
    /// Actual upstream round-trip milliseconds; absent before measurement or when unsupported.
    read-ping: func() -> result<option<u32>, string>;
    /// At most 16 nearby actors within 128 blocks; player rows require players, other rows entities.
    read-actors: func() -> result<list<actor>, string>;
    /// Reads a smaller prefix of the same authorized observations to bound guest copying work.
    /// limit is 1 through MAX_OBSERVED_ACTORS; filtering and session authority are unchanged.
    read-actors-limited: func(limit: u32) -> result<list<observed-actor>, string>;
    /// Incremental retained evidence, at most 4 entries per read. Requires player-state authority.
    /// Attack admission is outbound intent, NOT server confirmation; hurt carries NO attacker attribution.
    read-combat: func(after: u64, limit: u32) -> result<list<combat-event>, string>;
    record chat-message { sequence: u64, text: string }
    /// Newest 32 retained received messages, filtered by sequence > after, in FIFO order.
    /// limit is 1 through 4; individual text fields are at most 256 UTF-8 bytes.
    read-chat: func(after: u64, limit: u32) -> result<list<chat-message>, string>;
    record sidebar-row { label: string, score: s32 }
    record sidebar { title: string, rows: list<sidebar-row> }
    /// Session-fenced feet position and life state, readable while menus own input.
    read-world: func() -> result<option<world-observation>, string>;
    /// Measured completed client frames per real second, never the configured limit.
    read-fps: func() -> result<option<f32>, string>;
    /// Ordered, resolved sidebar names; none when the server has no sidebar.
    read-sidebar: func() -> result<option<sidebar>, string>;
    /// Requires the player-state grant. None outside the current connected session.
    /// Available while a screen owns input; carries no camera, interaction or packet authority.
    read-snapshot: func() -> result<option<snapshot>, string>;
    /// Exact content token for the current snapshot, scoped to this component instance.
    /// None outside a current snapshot. Shares the read-snapshot grant and read budget.
    /// Contents equal to the last full read reuse its token, even after unimported changes.
    read-revision: func() -> result<option<u64>, string>;
    record equipment {
        session: u64, dimension: s32, selected-slot: option<u8>,
        inventory: list<slot>, armor: list<slot>, offhand: slot,
    }
    record effects { session: u64, dimension: s32, effects: list<effect> }
    record revisions { session: u64, dimension: s32, equipment: u64, effects: u64 }
    /// Independent exact observation tokens. Equipment is unaffected by ticking effects.
    /// Tokens advance on observed changes and never repeat within an instance, including reconnects.
    /// These three reads share read-snapshot's grant, bounds, and callback read allowance.
    read-revisions: func() -> result<option<revisions>, string>;
    read-equipment: func() -> result<option<equipment>, string>;
    read-effects: func() -> result<option<effects>, string>;
}

/// An opt-in retained settings panel, rendered and hit-tested by the host.
interface panel {
    record event { id: string, value: f32 }
    /// Changes this instance's panel input ownership on successful callback return.
    /// Requires controls authority and a retained or pending panel when opening.
    set-open: func(open: bool) -> result<_, string>;
    /// Bounded panel JSON; empty text removes the panel and releases its input.
    set-content: func(json: string) -> result<_, string>;
    /// Applies a bounded sparse control patch and registered surface route atomically.
    /// Omitting controls preserves them; bindings, when present, replace custom scalars.
    update-content: func(json: string) -> result<_, string>;
}

/// Settings belong to the selected component's fixed companion file.
interface settings {
    load: func() -> result<string, string>;
    /// Stages bounded JSON for persistence after a successful callback.
    save: func(json: string) -> result<_, string>;
}

/// Local control edges, available only with explicit controls authority.
interface input {
    use panel.{event};
    record text-event { id: string, value: string }
    record field-key {
        id: string, key: string,
        shift: bool, control: bool, alt: bool, super-key: bool,
    }
    variant field-event {
        change(text-event),
        submit(text-event),
        key(field-key),
    }
    record controls {
        seconds: f32,
        focused: bool,
        gameplay: bool,
        panel-open: bool,
        /// Physical non-repeat edges; pointer buttons use MouseLeft/MouseRight/MouseMiddle.
        keys-pressed: list<string>,
        /// Physical keys held this frame, including reserved ones.
        keys-held: list<string>,
        events: list<event>,
    }
    record selection {
        /// None selects all keys; some(empty) selects none; names select exact matches.
        keys-pressed: option<list<string>>,
        keys-held: option<list<string>>,
        events: bool,
    }
    /// True only for the current frame's host-assigned action edge.
    demo-pressed: func() -> bool;
    read-controls: func() -> result<controls, string>;
    /// Reads selected fields from the same current frame, preserving native key order.
    /// Requires controls authority and shares the read-controls callback read budget.
    read-selected-controls: func(selection: selection) -> result<controls, string>;
    /// Committed single-line native text edits, separate from legacy numeric control events.
    /// Requires controls authority; repeated reads see the same bounded batch in a frame callback.
    read-text-events: func() -> result<list<text-event>, string>;
    /// Live values coalesce per field between frame callbacks. Submit and navigation retain order.
    /// Navigation includes the modifiers sampled at that key edge; preedit stays host-local.
    read-field-events: func() -> result<list<field-event>, string>;
    /// Physical key names reserved before the ordinary gameplay router samples them.
    reserve-keys: func(keys: list<string>) -> result<_, string>;
}

/// Local presentation only; no world mutation or outbound packets.
interface environment {
    /// Fixes visual time to 0–23999 ticks; none restores the tracked server clock.
    set-time-override: func(ticks: option<u32>) -> result<_, string>;
    /// Retained local lighting override; requires the separate fullbright grant.
    set-fullbright: func(enabled: bool) -> result<_, string>;
}

/// Explicit local gameplay capabilities; no raw packet access.
interface gameplay {
    record vector3 { x: f32, y: f32, z: f32 }
    /// Remote player feet in world coordinates, without names or network access.
    record player { runtime-id: u64, position: vector3 }
    /// Current input-owned frame only. Angles are actor YXZ radians: yaw left, pitch up.
    record snapshot {
        session: u64,
        dimension: s32,
        eye: vector3,
        yaw: f32,
        pitch: f32,
        attack-held: bool,
        frame-seconds: f32,
        players: list<player>,
    }
    /// Requires players or terrain; player rows require players. None means gameplay does not own input.
    read-frame: func() -> result<option<snapshot>, string>;
    /// Input-owned local physics state; velocity is blocks per simulation tick.
    record movement-snapshot {
        session: u64,
        dimension: s32,
        tick: u64,
        velocity: vector3,
        on-ground: bool,
        jump-held: bool,
        eligible: bool,
        knockback-sequence: u64,
    }
    /// Requires movement authority; none means gameplay does not own input.
    read-movement: func() -> result<option<movement-snapshot>, string>;
    /// Stages one ordinary jump input for the next physics tick, with movement authority.
    pulse-jump: func() -> result<_, string>;
    /// Cancels pending local jump input after a successful callback, even outside gameplay.
    cancel-jump: func() -> result<_, string>;
    record movement-toggles { toggle-sprint: bool, toggle-sneak: bool, always-sprint: bool }
    /// Renews ordinary input toggle modes for this focused gameplay frame. Omission restores saved settings.
    /// Requires movement authority; server movement, hunger and item-use restrictions still apply.
    set-movement-toggles: func(policy: option<movement-toggles>) -> result<_, string>;
    /// Requires the camera grant and a current frame; commits only after frame returns.
    rotate: func(yaw-delta: f32, pitch-delta: f32) -> result<_, string>;
    /// Bounded local actor attack range; none restores ordinary game-mode rules.
    set-attack-reach: func(blocks: option<f32>) -> result<_, string>;
    /// One attack-press edge, only while the physical attack control is held.
    pulse-attack: func() -> result<_, string>;
    /// Requires packet-delay authority; 0 drains the queue, maximum 1000 milliseconds.
    /// Delays post-login application packets in both directions, without raw packet access.
    /// Retained only after a successful callback; no current gameplay frame required.
    set-packet-delay: func(delay-ms: u32) -> result<_, string>;
    /// Requires packet-delay authority; opts into the host's last-relayed position witness.
    set-show-real-position: func(enabled: bool) -> result<_, string>;

    /// A nearby non-player actor; health comes from its replicated health attribute.
    record mob {
        runtime-id: u64,
        unique-id: s64,
        type-id: string,
        position: vector3,
        health: option<f32>,
        max-health: option<f32>,
    }
    /// Requires the entities grant and a current frame; nearest first, bounded by count and range.
    read-mobs: func() -> result<list<mob>, string>;

    /// Camera-local blocks (x right, y up, z back), roll in radians, FOV change in degrees.
    record camera-rig { offset: vector3, roll: f32, fov-delta: f32 }
    /// Retained third-person rig, swept against blocks; none restores the player's own view.
    set-camera-rig: func(rig: option<camera-rig>) -> result<_, string>;

    /// Sent as a player command request after frame returns; the command must be granted by name.
    request-command: func(command: string) -> result<_, string>;
}

/// Local presentation cues shared by loaded mods; they carry no authority.
interface events {
    record cue { name: string, values: list<f32> }
    /// Published to the host and every loaded mod after frame returns.
    emit: func(name: string, values: list<f32>) -> result<_, string>;
    /// Cues loaded mods committed last frame; the same bounded list for every call in a callback.
    poll: func() -> list<cue>;
}

/// Local custom rendering: sandboxed WGSL post-process passes and bounded world-space primitives.
interface render {
    use gameplay.{vector3};
    /// Linear colour; alpha scales coverage.
    record rgba { r: f32, g: f32, b: f32, a: f32 }
    /// Procedural ground styles animated by `progress` in 0–1.
    enum decal-style { telegraph, disc, crater, shockwave, dust }
    record decal { center: vector3, radius: f32, color: rgba, progress: f32, style: decal-style }
    /// Camera-facing strip that tapers and fades from the first point (head) to the last.
    record ribbon { points: list<vector3>, width: f32, color: rgba }
    /// Glowing animated strip from start to end; intensity scales its white-hot core.
    record beam { start: vector3, end: vector3, width: f32, color: rgba, intensity: f32 }
    enum billboard-pattern { solid, soft-disc, ring, spark, silhouette, sphere, aura }
    /// Camera-facing quad; upright quads keep their vertical axis.
    record billboard {
        position: vector3,
        width: f32,
        height: f32,
        color: rgba,
        pattern: billboard-pattern,
        upright: bool,
    }
    /// Retained full-block highlights for matching blocks already loaded by the host.
    record block-highlight-spec { identifiers: list<string>, range: f32, color: rgba }
    /// Requires block-highlights authority; none clears this instance's selection.
    set-block-highlights: func(spec: option<block-highlight-spec>) -> result<_, string>;
    record primitives {
        decals: list<decal>,
        ribbons: list<ribbon>,
        beams: list<beam>,
        billboards: list<billboard>,
    }
    /// `source` defines `fn effect(uv: vec2<f32>) -> vec3<f32>`, the new scene colour, against the host prelude.
    record pass-spec { name: string, order: s32, source: string, depth: bool }
    /// Validates a pass; passes run after the scene and before the HUD, by order then name.
    register-pass: func(spec: pass-spec) -> result<_, string>;
    remove-pass: func(name: string) -> result<_, string>;
    /// Retained enable flag and up to 16 floats exposed to the shader as `param(i)`.
    update-pass: func(name: string, enabled: bool, params: list<f32>) -> result<_, string>;
    /// Appends to this callback's primitives; each successful callback replaces the drawn set.
    draw: func(primitives: primitives) -> result<_, string>;
    enum line-pattern { solid, dashed, dotted }
    /// Camera-facing line with width in physical pixels and an original procedural pattern.
    record line { points: list<vector3>, width: f32, color: rgba, pattern: line-pattern }
    /// Appends depth-tested lines with the same authority and shared ribbon budget.
    draw-lines: func(lines: list<line>) -> result<_, string>;
}

/// The mod's JSON-UI templates beside the vanilla container screens. Templates are the
/// `ui/<name>.json` files `mod.toml` indexes, in the mod's own namespace; they resolve only
/// against the vanilla catalog, as a client part's modal templates do. Every function but
/// `layout` errs when the `screen` permission is denied.
interface screen {
    use cinnabar:server-experience/ui@1.3.0.{value, gui-size};

    /// A rectangle in GUI units, from the top left of the screen root.
    record rect {
        x: f64,
        y: f64,
        width: f64,
        height: f64,
    }

    /// The open container screen as laid out for this frame.
    record screen-layout {
        /// The vanilla JSON-UI screen drawn, such as `crafting.inventory_screen`.
        screen: string,
        /// The root's size in GUI units and the GUI scale, as `ui.modal-size` reports them.
        size: gui-size,
        /// The union of the vanilla screen's laid-out panels, an open recipe book included.
        gui: rect,
        /// Other vanilla areas outside `gui` that the overlay may not draw on: the recipe book's
        /// tabs, the status effects and toasts.
        exclusions: list<rect>,
        /// The open view's laid-out bounds. While the view is up the vanilla screen is hidden,
        /// and the overlay is clipped against this rect (and the exclusions) instead of `gui`.
        view: option<rect>,
    }

    /// The modifier keys held with a wheel turn.
    flags modifiers {
        ctrl,
        shift,
        alt,
    }

    /// The open container screen's layout; none while no container screen is up.
    layout: func() -> option<screen-layout>;
    /// Draws `template` beside every container screen, laid out over the whole root but drawn
    /// and hit only outside `gui` and the exclusions; none removes it.
    set-overlay: func(template: option<string>) -> result<_, string>;
    /// Draws `template` over the open container screen, which stays open and is hidden while
    /// the view is up; none, Escape or closing the container returns. Errs while no container
    /// screen is up.
    open-view: func(template: option<string>) -> result<_, string>;
    /// Replaces a collection's rows, as client WIT 1.2's `ui.set-collection`.
    set-collection: func(name: string, rows-json: list<u8>) -> result<_, string>;
    /// Binds one `#binding` name for the overlay and the view, as `ui.set-value`.
    set-value: func(name: string, value: value) -> result<_, string>;
    /// Sets the text of edit boxes named `control`, as `ui.set-text`.
    set-text: func(control: string, text: string) -> result<_, string>;
    /// Selects the drawn edit box named `control`, as a press on it would.
    focus-text: func(control: string) -> result<_, string>;
    /// The modifier keys held with the event being delivered, such as Shift with a press.
    held-modifiers: func() -> modifiers;
    /// Monotonic seconds since the mod loaded, to animate by, as JEI cycles ingredients.
    elapsed-seconds: func() -> f64;
}

/// Vanilla inventory requests a player mod asks for; each is one the vanilla screens can make,
/// and the server checks it. Every function errs without the `inventory` permission. Requests
/// are sent after the callback returns, at most `MAX_INVENTORY_REQUESTS` per callback.
interface inventory {
    use cinnabar:session/items@0.1.0.{item-key};

    /// Takes `count` of creative item `key` into the first free inventory slot, else the
    /// cursor, as a click on the creative catalog does. Errs outside Creative or when the
    /// item is not in the creative content.
    creative-take: func(key: item-key, count: u8) -> result<_, string>;
    /// Crafts crafting recipe `network-id` once from inventory ingredients onto the cursor, as
    /// a click on the recipe book does. Errs while no crafting screen is up.
    fill-recipe: func(network-id: u32) -> result<_, string>;
}

/// Opt-in local camera policy; requires the explicit camera grant.
interface camera {
    /// Damage shake only; death rotation and ordinary view bob remain independent.
    record hurt-camera-style { intensity: f32, old-tilt: bool }
    /// Current-frame damage presentation, with finite intensity from zero through two.
    /// Presentation remains available while a menu owns input. None, omission, unload,
    /// and failed callbacks restore current player settings; this does not change look or movement.
    set-hurt-camera-style: func(style: option<hurt-camera-style>) -> result<_, string>;
    /// Renew every frame. Only actual teleports preserve yaw/pitch; position and acknowledgments remain unchanged.
    /// Omission, no gameplay frame, or a failed callback restores server rotation.
    set-preserve-teleport-rotation: func(enabled: bool) -> result<_, string>;
    /// Current-frame FOV and look multipliers, independently bounded to 0.1..1 and 0.05..1.
    /// Renew only during focused, input-owned gameplay; 1/1 restores the player's view.
    /// Omission, UI focus, unload, and failed callbacks restore both scales without changing saved settings or perspective.
    set-view-scale: func(fov-scale: f32, look-scale: f32) -> result<_, string>;
}

/// Opt-in item-use policy; requires the explicit item-use grant.
interface item-use {
    /// Renew each gameplay frame. Allows one immediate air use after each slot change and air use while attacking.
    /// Repeat timing, item cooldowns and tick admission remain intact.
    /// Omission, no gameplay frame, and failed callbacks restore vanilla timing.
    set-delay-fix: func(enabled: bool) -> result<_, string>;
}

/// Bounded local terrain reads. The queries a callback reads become its subscriptions, which the
/// client samples before later frames, so a new query reads `pending` first. A deferred callback
/// keeps its subscriptions. Unknown terrain is never reported as air.
interface terrain {
    record position { x: s32, y: s32, z: s32 }
    flags geometry { collision, selection }
    /// Inclusive minimum and exclusive maximum; each extent is 1 to `MAX_TERRAIN_EXTENT` blocks.
    record region-query { min: position, max: position, geometry: geometry }
    /// Identifies one sample of one query; an equal stamp means identical contents.
    record stamp { session: u64, dimension: s32, registry: u64, revision: u64 }
    flags physics-flags { climbable, water, lava, cobweb, powder-snow, scaffolding, passable }
    enum surface-response { none, slime, bed, honey, soul-sand, bubble-up, bubble-down }
    record physics {
        friction: f64, horizontal-speed-factor: f64, vertical-speed-factor: f64,
        fluid-height: f64, %flags: physics-flags, surface: surface-response,
    }
    /// An index into the region's shapes; shape 0 is known-empty.
    variant resolved-shape { unavailable, known(u32) }
    variant shape-binding {
        not-requested,
        fixed(resolved-shape),
        /// Every occurrence has an override.
        per-cell,
    }
    /// One distinct runtime ID; metadata and physics are absent when the registry lacks them.
    record block-state {
        runtime-id: u32, identifier: option<string>, canonical-state: option<string>,
        tags: list<string>, physics: option<physics>,
        collision: shape-binding, selection: shape-binding,
    }
    /// Revision of a column the region depends on; none is absent terrain.
    record chunk-revision { x: s32, z: s32, revision: option<u64> }
    /// Geometry of one layer slot that depends on its position; none keeps the state's binding.
    record shape-override { slot: u32, collision: option<resolved-shape>, selection: option<resolved-shape> }
    /// Cell `((x * size-z) + z) * size-y + y`, relative to the minimum, has layer `l` at slot
    /// `l * cells + cell`. Shapes are block-local, with native position offsets applied.
    record region {
        stamp: stamp,
        /// Every column read, including those consulted for neighbour or actor geometry.
        chunks: list<chunk-revision>,
        layer-count: u8,
        /// Bit `cell % 64` of word `cell / 64` is set for known cells.
        loaded: list<u64>,
        /// Palette index per slot; 65535 is no layer, never air.
        states: list<u16>,
        palette: list<block-state>,
        /// Shape `s` is boxes `shape-offsets[s]` to `shape-offsets[s + 1]`.
        shape-offsets: list<u32>,
        /// Six values per box: minimum then maximum x, y and z.
        shape-boxes: list<f64>,
        /// Sorted by slot.
        overrides: list<shape-override>,
    }
    variant read-result { pending, unchanged(stamp), changed(region) }
    enum read-error { denied, unavailable, invalid-query, out-of-range, budget-exhausted, limit-exceeded }
    /// Requires terrain authority and a gameplay frame; the query lies within
    /// `MAX_TERRAIN_DISTANCE` blocks of the player's feet on each axis. Pass the stamp last received
    /// for this query to skip unchanged data. Limits are `mod-api`'s `MAX_TERRAIN_*` constants.
    read-region: func(query: region-query, after: option<stamp>) -> result<read-result, read-error>;
}

/// Experimental developer contract; no WASI or ambient operating-system access.
world extension {
    import cinnabar:world-draw/masks@0.1.0;
    import terrain;
    import player-state;
    import item-use;
    import camera;
    import hud;
    import input;
    import environment;
    import gameplay;
    import events;
    import panel;
    import settings;
    import render;
    import cinnabar:world-draw/drawing@0.1.0;
    /// Creates the initial retained UI state.
    export init: func();
    /// Bounded frame callback used to measure the spike's crossing cost.
    export frame: func();
}

/// `extension` plus screens beside the container screens, the session's read-only items and
/// recipes, declared keys and event callbacks. A mod package (`mod.toml`) targets this world.
///
/// Every event export is optional: the host type-checks each one a component exports, refusing
/// one of another signature, and never calls one it lacks. New events arrive as new exports, so
/// a built component keeps working. `init` and `frame` stay required.
world player-mod {
    include extension;
    import screen;
    import inventory;
    import cinnabar:session/items@0.1.0;
    import cinnabar:session/recipes@0.1.0;

    use screen.{screen-layout, modifiers};
    use cinnabar:session/items@0.1.0.{stack};

    /// What a `data-changed` reports as changed. Closed: changing it would refuse every built
    /// `data-changed`, so a new kind of change arrives as a new optional export instead.
    enum data-source {
        items,
        recipes,
    }

    /// A container screen opened, closed (`none`) or was laid out anew.
    export screen-changed: func(layout: option<screen-layout>);
    /// A primary press on an overlay or view control mapped to a declared action; the index is
    /// the control's row in its nearest collection.
    export action: func(id: string, collection-index: option<u32>);
    /// A secondary press (a right click) on a control that maps `button.menu_secondary_select`
    /// to a declared action.
    export secondary-action: func(id: string, collection-index: option<u32>);
    /// The wheel turned `delta` notches (one per detent; a pixel-precise wheel reports its
    /// pixels / 16) with the pointer at `x`, `y` in GUI units, over the overlay's drawn area or
    /// the view, with `modifiers` held. Positive scrolls down, towards the end.
    export scrolled: func(delta: f64, x: f64, y: f64, modifiers: modifiers);
    /// The text of the edit box named `control`, a declared action, changed.
    export text-changed: func(control: string, text: string);
    /// A declared key was pressed while a container screen or the view was up and no edit box
    /// had focus. `hovered` is the vanilla slot's stack under the pointer; `row` is the
    /// collection name and index of the mod's control under the pointer, overlay or view, by
    /// the rule `action` uses (its nearest collection).
    export key: func(id: string, hovered: option<stack>, row: option<tuple<string, u32>>);
    /// The listed session sources changed revision, each listed once. It gets the load fuel
    /// budget, as does `init` of a component that exports it.
    export data-changed: func(sources: list<data-source>);
    /// The host closed the view (Escape, or the container closing), not the mod.
    export view-closed: func();
}

/// Every session packet, relayed through one trusted mod. A batch is the session contract's batch
/// body: each packet as a varuint32 byte length followed by the encoded packet, header included,
/// in the session's protocol.
interface packet-relay {
    /// The way a batch travels.
    enum direction { from-client, from-server }

    /// The upstream login's canonical player identity.
    record session-identity {
        display-name: string,
        xuid: string,
        uuid: string,
    }

    /// A resource pack the mod adds to the session.
    record session-pack {
        /// The pack's zip archive; its manifest identity must not repeat another pack in the stack.
        archive: list<u8>,
        /// Whether the pack applies above the server's packs rather than below them.
        above-server: bool,
    }

    /// Batch bodies the mod sends outside a relayed batch; an empty body sends nothing.
    record outbound {
        to-client: list<u8>,
        to-server: list<u8>,
    }
}

/// A trusted mod that relays every session packet. It needs the `packets` grant; WASI preview 2
/// is linked only with the `wasi` grant, without files, environment, arguments or network.
world packet-mod {
    use packet-relay.{direction, session-identity, session-pack, outbound};

    /// Begins a session: the upstream identity, the login client data as the session's Connect sent
    /// it (JSON), and the server's startup packets through StartGame as one batch body. Returns the
    /// resource packs the mod adds.
    export start: func(identity: session-identity, client-data: string, startup: list<u8>) -> result<list<session-pack>, string>;
    /// Handles one relayed batch: none forwards it unchanged; some replaces it, and an empty body
    /// drops it.
    export on-batch: func(direction: direction, batch: list<u8>) -> result<option<list<u8>>, string>;
    /// Runs timed work about once per client tick (50 ms) and returns packets to send now.
    export tick: func() -> result<outbound, string>;
    /// Ends the session.
    export stop: func();
}

  "review_transitions": [
    {
      "from": "draft",
      "action": "submit",
      "to": "pending",
      "permission": "submission.submit",
      "owner": "self",
      "requires_reason": false
    },
    {
      "from": "changes_requested",
      "action": "submit",
      "to": "pending",
      "permission": "submission.submit",
      "owner": "self",
      "requires_reason": false
    },
    {
      "from": "pending",
      "action": "approve",
      "to": "published",
      "permission": "submission.review",
      "owner": "other",
      "requires_reason": true
    },
    {
      "from": "pending",
      "action": "request_changes",
      "to": "changes_requested",
      "permission": "submission.review",
      "owner": "other",
      "requires_reason": true
    },
    {
      "from": "published",
      "action": "suspend",
      "to": "suspended",
      "permission": "listing.suspend",
      "owner": "other",
      "requires_reason": true
    }
  ],

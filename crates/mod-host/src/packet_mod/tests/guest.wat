;; A packet-mod core module through the world's canonical ABI. `on-batch` acts on the batch's
;; first byte: 1 replaces it with the direction, 2 drops it, 3 traps, 4 spins, 5 refuses,
;; 6 grows memory past the limit, 7 returns an out-of-bounds list; anything else forwards it.
(module
  $IMPORTS
  (memory (export "memory") 4)
  (global $next (mut i32) (i32.const 32768))
  (data (i32.const 1024) "c")
  (data (i32.const 1032) "s")
  (data (i32.const 1040) "refused")
  (data (i32.const 1048) "hello\n")
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32)
    (local $old i32)
    (local.set $old (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
    (global.set $next (i32.add (local.get $old) (local.get 3)))
    (local.get $old))
  (func $fail (result i32)
    (i32.store8 (i32.const 128) (i32.const 1))
    (i32.store (i32.const 132) (i32.const 1040))
    (i32.store (i32.const 136) (i32.const 7))
    (i32.const 128))
  (func (export "start")
    (param $name i32) (param $name_len i32) (param $xuid i32) (param $xuid_len i32)
    (param $uuid i32) (param $uuid_len i32) (param $data i32) (param $data_len i32)
    (param $startup i32) (param $startup_len i32) (result i32)
    $START
    (i32.store (i32.const 256) (local.get $name))
    (i32.store (i32.const 260) (local.get $name_len))
    (i32.store8 (i32.const 264) (i32.ne (local.get $startup_len) (i32.const 0)))
    (i32.store (i32.const 268) (local.get $data))
    (i32.store (i32.const 272) (local.get $data_len))
    (i32.store8 (i32.const 276) (i32.const 0))
    (i32.store8 (i32.const 128) (i32.const 0))
    (i32.store (i32.const 132) (i32.const 256))
    (i32.store (i32.const 136) (i32.const 2))
    (i32.const 128))
  (func (export "on-batch") (param $direction i32) (param $batch i32) (param $length i32) (result i32)
    (local $op i32)
    (local.set $op (i32.load8_u (local.get $batch)))
    (i32.store8 (i32.const 128) (i32.const 0))
    (i32.store8 (i32.const 132) (i32.const 0))
    (if (i32.eq (local.get $op) (i32.const 1)) (then
      (i32.store8 (i32.const 512) (local.get $direction))
      (i32.store8 (i32.const 132) (i32.const 1))
      (i32.store (i32.const 136) (i32.const 512))
      (i32.store (i32.const 140) (i32.const 1))))
    (if (i32.eq (local.get $op) (i32.const 2)) (then
      (i32.store8 (i32.const 132) (i32.const 1))
      (i32.store (i32.const 136) (i32.const 512))
      (i32.store (i32.const 140) (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 3)) (then unreachable))
    (if (i32.eq (local.get $op) (i32.const 4)) (then (loop $spin (br $spin))))
    (if (i32.eq (local.get $op) (i32.const 5)) (then (return (call $fail))))
    (if (i32.eq (local.get $op) (i32.const 6)) (then (drop (memory.grow (i32.const 16385)))))
    (if (i32.eq (local.get $op) (i32.const 7)) (then
      (i32.store8 (i32.const 132) (i32.const 1))
      (i32.store (i32.const 136) (i32.const 262140))
      (i32.store (i32.const 140) (i32.const 100))))
    (i32.const 128))
  (func (export "tick") (result i32)
    (i32.store8 (i32.const 128) (i32.const 0))
    (i32.store (i32.const 132) (i32.const 1024))
    (i32.store (i32.const 136) (i32.const 1))
    (i32.store (i32.const 140) (i32.const 1032))
    (i32.store (i32.const 144) (i32.const 1))
    (i32.const 128))
  (func (export "stop")))

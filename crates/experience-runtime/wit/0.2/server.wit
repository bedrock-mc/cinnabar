package cinnabar:experience-server@0.2.0;

interface types {
    record block-pos { x: s32, y: s32, z: s32 }
    enum face { down, up, north, south, west, east }
    /// Canonical lowercase hyphenated UUID; an opaque identity, not a credential.
    type player-id = string;
    enum log-level { debug, info, warn, error }
    enum world-error {
        denied, unavailable, out-of-bounds, unknown-block, unsupported-state,
        not-owned, too-large, quota-exceeded, player-unavailable, invalid-text,
    }
    variant guest-error { rejected(string), failed(string) }
    /// slot is "*", "up", "down", "north", "south", "east" or "west"; path is under assets/.
    record texture-binding { slot: string, path: string }
    variant mining { unbreakable, breakable(f32) }
    record block-def { id: string, display-name: string, textures: list<texture-binding>, mining: mining }
    record callback-info { world-id: string, dimension-id: string, tick: u64, event-sequence: u64 }
    enum change-cause { player, guest, environment }
    record block-change {
        pos: block-pos, actor: option<player-id>, cause: change-cause,
        before-id: string, after-id: string, previous-data: option<list<u8>>,
    }
    /// One field of a client-channel record, as the client part's channel declares it.
    variant scalar { %bool(bool), integer(s64), text(string), choice(u16) }
}

interface world-access {
    use types.{block-pos, player-id, callback-info, world-error, scalar};
    /// Created only by the host, for one callback invocation.
    resource callback {
        info: func() -> callback-info;
        get-block: func(pos: block-pos) -> result<string, world-error>;
        set-block: func(pos: block-pos, id: string) -> result<_, world-error>;
        block-data: func(pos: block-pos) -> result<option<list<u8>>, world-error>;
        /// none deletes the record.
        set-block-data: func(pos: block-pos, data: option<list<u8>>) -> result<_, world-error>;
        tell: func(player: player-id, text: string) -> result<_, world-error>;
        /// Stages `payload` for `player`'s client part on `channel`, revision `schema`. It is sent
        /// after the callback commits, if that player's client part declares the channel.
        send-client: func(player: player-id, channel: string, schema: u16, payload: list<scalar>) -> result<_, world-error>;
    }
}

interface diagnostics {
    use types.{log-level};
    log: func(level: log-level, text: string);
}

world server {
    import world-access;
    import diagnostics;
    use world-access.{callback};
    use types.{block-def, block-change, block-pos, player-id, face, guest-error, scalar};
    export register: func() -> result<list<block-def>, guest-error>;
    export on-place: func(ctx: borrow<callback>, change: block-change) -> result<_, guest-error>;
    export on-break: func(ctx: borrow<callback>, change: block-change) -> result<_, guest-error>;
    export on-interact: func(ctx: borrow<callback>, player: player-id, pos: block-pos, clicked-face: face) -> result<_, guest-error>;
    export on-neighbor-changed: func(ctx: borrow<callback>, pos: block-pos, neighbor: block-pos) -> result<_, guest-error>;
    /// `player`'s client part sent `payload` on `channel`, revision `schema`. `ctx` has no
    /// snapshot, so every world read and write is refused.
    export client-message: func(ctx: borrow<callback>, player: player-id, channel: string, schema: u16, payload: list<scalar>) -> result<_, guest-error>;
}

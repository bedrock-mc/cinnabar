SPECTATOR_LISTEN_ADDRESS=10.0.0.69:3002
SPECTATOR_WEBSITE_URL=http://127.0.0.1:3001
SPECTATOR_PUBLIC_ORIGIN=https://dev.zenomc.org
SPECTATOR_NATS_URL=nats://127.0.0.1:4222
# Trust only the actual ForwardMe proxy peer. Update if its Docker address changes.
SPECTATOR_TRUSTED_PROXIES=127.0.0.1/32,172.23.0.2/32
# Optional NATS credentials file; mount it read-only when authentication is enabled.
SPECTATOR_NATS_CREDENTIALS_FILE=
GOMAXPROCS=1
GOMEMLIMIT=300MiB

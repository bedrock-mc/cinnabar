{
  "namespace": "cinnabar_touch",
  "button": {
    "type": "button",
    "layer": 10,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$control",
        "mapping_type": "pressed",
        "scope": "view"
      }
    ],
    "controls": [
      {
        "normal": {
          "type": "image",
          "texture": "$texture",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "held": {
          "type": "image",
          "texture": "$held_texture",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "$held_binding",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "screen": {
    "type": "screen",
    "render_only_when_topmost": false,
    "controls": [
      {
        "look": {
          "type": "input_panel",
          "size": [
            "100%",
            "100%"
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "cinnabar.touch.look",
              "mapping_type": "pressed",
              "scope": "view"
            }
          ]
        }
      },
      {
        "joystick": {
          "type": "button",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "-35%",
            "5%"
          ],
          "size": [
            "100%y",
            "33.33333333333333%"
          ],
          "layer": 10,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "cinnabar.touch.joystick",
              "mapping_type": "pressed",
              "scope": "view"
            }
          ],
          "controls": [
            {
              "frame": {
                "type": "image",
                "texture": "textures/ui/joystick_frame",
                "size": [
                  "100%",
                  "100%"
                ]
              }
            },
            {
              "knob": {
                "type": "draggable",
                "draggable": "both",
                "size": [
                  "50%",
                  "50%"
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 1,
                "controls": [
                  {
                    "art": {
                      "type": "image",
                      "texture": "textures/ui/joystick_knob",
                      "size": [
                        "100%",
                        "100%"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "sprint@cinnabar_touch.button": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "32.5%",
            "0%"
          ],
          "size": [
            "100%y",
            "13.75%"
          ],
          "$control": "cinnabar.touch.sprint",
          "$texture": "textures/ui/sprint",
          "$held_texture": "textures/ui/sprint_pressed",
          "$held_binding": "#touch_sprint_pressed"
        }
      },
      {
        "jump@cinnabar_touch.button": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "42.5%",
            "-10%"
          ],
          "size": [
            "100%y",
            "13.75%"
          ],
          "$control": "cinnabar.touch.jump",
          "$texture": "textures/ui/jump",
          "$held_texture": "textures/ui/jump_pressed",
          "$held_binding": "#touch_jump_pressed"
        }
      },
      {
        "sneak@cinnabar_touch.button": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "42.5%",
            "10%"
          ],
          "size": [
            "100%y",
            "13.75%"
          ],
          "$control": "cinnabar.touch.sneak",
          "$texture": "textures/ui/sneak",
          "$held_texture": "textures/ui/sneak_pressed",
          "$held_binding": "#touch_sneak_pressed"
        }
      },
      {
        "attack@cinnabar_touch.button": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "32.5%",
            "20%"
          ],
          "size": [
            "100%y",
            "13.75%"
          ],
          "$control": "cinnabar.touch.attack",
          "$texture": "textures/ui/attack",
          "$held_texture": "textures/ui/attack_pressed",
          "$held_binding": "#touch_attack_pressed"
        }
      },
      {
        "use@cinnabar_touch.button": {
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            "42.5%",
            "30%"
          ],
          "size": [
            "100%y",
            "13.75%"
          ],
          "$control": "cinnabar.touch.use",
          "$texture": "textures/ui/interact",
          "$held_texture": "textures/ui/interact_pressed",
          "$held_binding": "#touch_use_pressed"
        }
      },
      {
        "utilities": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [
            58,
            18
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            3
          ],
          "controls": [
            {
              "utilities@cinnabar_touch.menu_button": {
                "$control": "cinnabar.touch.utilities",
                "layer": 30
              }
            },
            {
              "gap_before_chat": {
                "type": "panel",
                "size": [
                  2,
                  18
                ]
              }
            },
            {
              "chat@cinnabar_touch.utility_button": {
                "$control": "cinnabar.touch.chat",
                "$uv": [
                  200,
                  82
                ]
              }
            },
            {
              "gap_before_pause": {
                "type": "panel",
                "size": [
                  2,
                  18
                ]
              }
            },
            {
              "menu@cinnabar_touch.menu_button": {
                "$control": "cinnabar.touch.menu"
              }
            }
          ]
        }
      },
      {
        "utilities_dismiss": {
          "type": "input_panel",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 20,
          "bindings": [
            {
              "binding_name": "#touch_utilities_open",
              "binding_name_override": "#visible"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "cinnabar.touch.dismiss_utilities",
              "mapping_type": "pressed",
              "scope": "view"
            }
          ]
        }
      },
      {
        "utilities_dropdown": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            116,
            "100%c"
          ],
          "layer": 21,
          "bindings": [
            {
              "binding_name": "#touch_utilities_open",
              "binding_name_override": "#visible"
            }
          ],
          "controls": [
            {
              "debug_overlay@cinnabar_touch.utility_menu_item": {
                "$control": "cinnabar.touch.debug_overlay",
                "$text": "Debug Overlay",
                "$active": "#touch_debug_overlay_active"
              }
            },
            {
              "player_list@cinnabar_touch.utility_menu_item": {
                "$control": "cinnabar.touch.player_list",
                "$text": "Player List",
                "$active": "#touch_player_list_active"
              }
            },
            {
              "emote@cinnabar_touch.utility_menu_item": {
                "$control": "cinnabar.touch.emote",
                "$text": "Emotes",
                "$active": "#touch_never_active"
              }
            }
          ],
          "draggable": "both"
        }
      }
    ]
  },
  "utility_button": {
    "type": "button",
    "size": [
      18,
      18
    ],
    "layer": 10,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$control",
        "mapping_type": "pressed",
        "scope": "view"
      }
    ],
    "controls": [
      {
        "art": {
          "type": "image",
          "texture": "textures/gui/gui",
          "uv": "$uv",
          "uv_size": [
            18,
            18
          ],
          "size": [
            "100%",
            "100%"
          ]
        }
      }
    ]
  },
  "utility_menu_item": {
    "type": "button",
    "size": [
      "100%",
      28
    ],
    "layer": 22,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$control",
        "mapping_type": "pressed",
        "scope": "view"
      }
    ],
    "controls": [
      {
        "background@cinnabar_touch.utility_idle": {}
      },
      {
        "hover@cinnabar_touch.utility_idle": {}
      },
      {
        "pressed@cinnabar_touch.utility_pressed": {}
      }
    ],
    "default_control": "background",
    "hover_control": "hover",
    "pressed_control": "pressed"
  },
  "menu_button@cinnabar_touch.utility_button": {
    "$uv": [
      200,
      64
    ]
  },
  "utility_idle": {
    "type": "image",
    "texture": "textures/ui/joystick_knob",
    "nineslice_size": [
      4,
      4,
      4,
      6
    ],
    "keep_ratio": false,
    "size": [
      "100%",
      "100% - 2px"
    ],
    "controls": [
      {
        "content@cinnabar_touch.utility_content": {
          "offset": [
            4,
            4
          ],
          "$content_color": [
            0,
            0,
            0
          ]
        }
      }
    ]
  },
  "utility_pressed": {
    "type": "image",
    "texture": "textures/ui/jump_pressed",
    "nineslice_size": [
      7,
      6,
      7,
      6
    ],
    "keep_ratio": false,
    "size": [
      "100%",
      "100% - 2px"
    ],
    "controls": [
      {
        "glyph_cover": {
          "type": "image",
          "texture": "textures/ui/jump_pressed",
          "uv": [
            4,
            5
          ],
          "uv_size": [
            1,
            1
          ],
          "keep_ratio": false,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            7,
            6
          ],
          "size": [
            "100% - 14px",
            "100% - 12px"
          ],
          "layer": 1
        }
      },
      {
        "content@cinnabar_touch.utility_content": {
          "offset": [
            4,
            5
          ],
          "$content_color": [
            0.9019607843137255,
            0.9019607843137255,
            0.9019607843137255
          ]
        }
      }
    ]
  },
  "utility_content": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      "100% - 8px",
      "100% - 10px"
    ],
    "layer": 2,
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "$text",
          "localize": false,
          "color": "$content_color",
          "shadow": false,
          "text_alignment": "left",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            4,
            0
          ],
          "size": [
            "100% - 18px",
            "default"
          ]
        }
      },
      {
        "active": {
          "type": "image",
          "texture": "textures/ui/checkmark_white",
          "color": "$content_color",
          "size": [
            8,
            6
          ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            -3,
            0
          ],
          "bindings": [
            {
              "binding_name": "$active",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}

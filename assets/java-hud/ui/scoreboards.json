// Cinnabar's built-in Java-styled sidebar: rows 9 GUI px apart, names left
// and red scores right with a ": "-wide gap, a 0.4-opacity title band over a
// 0.3 body, its right edge 1 GUI px in and its bottom one third of the rows'
// height below the screen middle. Server packs override these definitions.
{
  "namespace": "scoreboard",

  "scoreboard_sidebar_score": {
    "type": "label",
    "layer": 2,
    "size": [ "default", 9 ],
    "text": "#player_score_sidebar",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "color": [ 1.0, 0.333, 0.333 ],
    "localize": false,
    "bindings": [
      {
        "binding_name": "#player_score_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_scores"
      }
    ]
  },

  "scoreboard_sidebar_player": {
    "type": "label",
    "layer": 2,
    "size": [ "default", 9 ],
    "text": "#player_name_sidebar",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "color": "$player_name_color",
    "localize": false,
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      }
    ]
  },

  // Symmetric anchors preserve a server's full-screen replacement. The inner
  // box's bottom remains a third of its height below the screen middle.
  "scoreboard_sidebar": {
    "type": "panel",
    "size": [ "100%c", "66.6666666%c" ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "controls": [
      {
        "main": {
          "type": "panel",
          "size": [ "100%cm + 4px", "100%cm" ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -1, -3.3333333 ],
          "controls": [
            {
              "body_background": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": "#alpha",
                "size": [ "100%", "100% - 9px" ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 0, 9 ],
                "bindings": [
                  {
                    "binding_name": "#objective_background_opacity",
                    "binding_name_override": "#alpha"
                  }
                ]
              }
            },
            {
              "displayed_objective_background": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": "#alpha",
                "size": [ "100%", 9 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 1,
                "bindings": [
                  {
                    "binding_name": "#scoreboard_objective_background_opacity",
                    "binding_name_override": "#alpha"
                  }
                ]
              }
            },
            {
              "content": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%cm", "100%c" ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 2, 0 ],
                "use_child_anchors": true,
                "controls": [
                  {
                    "title_row": {
                      "type": "panel",
                      "size": [ "100%cm", 10 ],
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "controls": [
                        {
                          "displayed_objective": {
                            "type": "label",
                            "size": [ "default", 9 ],
                            "text": "#objective_sidebar_name",
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "offset": [ 0, 1 ],
                            "layer": 2,
                            "color": "$objective_title_color",
                            "localize": false,
                            "bindings": [
                              {
                                "binding_name": "#objective_sidebar_name",
                                "binding_type": "global"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "lists": {
                      "type": "panel",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "inherit_max_sibling_width": true,
                      "size": [ "100%c", "100%cm" ],
                      "controls": [
                        {
                          "players": {
                            "type": "stack_panel",
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "size": [ "100%cm", "100%c" ],
                            "orientation": "vertical",
                            "collection_name": "scoreboard_players",
                            "factory": {
                              "name": "player_list_factory",
                              "control_name": "scoreboard.scoreboard_sidebar_player"
                            },
                            "bindings": [
                              {
                                "binding_name": "#scoreboard_sidebar_size",
                                "binding_type": "global",
                                "binding_name_override": "#collection_length"
                              }
                            ]
                          }
                        },
                        {
                          "separator": {
                            "type": "panel",
                            "size": [ 6, 0 ]
                          }
                        },
                        {
                          "scores": {
                            "type": "stack_panel",
                            "anchor_from": "top_right",
                            "anchor_to": "top_right",
                            "size": [ "100%cm", "100%c" ],
                            "orientation": "vertical",
                            "use_child_anchors": true,
                            "collection_name": "scoreboard_scores",
                            "factory": {
                              "name": "player_score_factory",
                              "control_name": "scoreboard.scoreboard_sidebar_score"
                            },
                            "bindings": [
                              {
                                "binding_name": "#scoreboard_sidebar_size",
                                "binding_type": "global",
                                "binding_name_override": "#collection_length"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
